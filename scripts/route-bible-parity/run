#!/bin/sh
# Regenerate bible-rs's route.bible parity data. Usage: scripts/route-bible-parity/run <route.bible checkout>
set -eu
rb=$(cd "$1" && pwd)
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
tmp=$(mktemp -d)
(cd "$rb" && npx esbuild "$here/gen.ts" --bundle --platform=node --format=esm --alias:rb="$rb" \
  --outfile="$tmp/gen.mjs" --log-level=warning)
BIBLE_RS_DIR="$root" ROUTE_BIBLE_DIR="$rb" node "$tmp/gen.mjs"
rm -rf "$tmp"
