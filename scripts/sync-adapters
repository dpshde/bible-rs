#!/usr/bin/env bash
# Refresh the committed route.bible adapters snapshot under crates/core/data/.
#
# Thin wrapper around the opt-in build-time ingest:
#   ROUTE_BIBLE_ADAPTERS=refresh cargo build -p bible-core
# then copies the staged OUT_DIR artifacts back into data/ for committing.
#
# Usage:
#   scripts/sync-adapters
#   ROUTE_BIBLE_FEED=https://route.bible/adapters/v1 scripts/sync-adapters
#
# Offline / sandboxed: omit refresh and the build keeps using data/ as-is.
# No CI workflow is added — release docs flip ROUTE_BIBLE_ADAPTERS=refresh when desired.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export ROUTE_BIBLE_ADAPTERS="${ROUTE_BIBLE_ADAPTERS:-refresh}"
export ROUTE_BIBLE_FEED="${ROUTE_BIBLE_FEED:-https://route.bible/adapters/v1}"

echo "sync-adapters: building bible-core with ROUTE_BIBLE_ADAPTERS=$ROUTE_BIBLE_ADAPTERS"
cargo build -p bible-core 2>&1 | tee /tmp/bible-core-adapters-build.log

# Locate the most recent OUT_DIR for bible-core's build script.
OUT="$(
  find target -type d -path '*/build/bible-core-*/out' 2>/dev/null \
    | xargs -I{} stat -c '%Y {}' {} 2>/dev/null \
    | sort -nr \
    | head -1 \
    | cut -d' ' -f2-
)"
if [[ -z "${OUT}" || ! -d "${OUT}" ]]; then
  # macOS stat fallback
  OUT="$(
    find target -type d -path '*/build/bible-core-*/out' 2>/dev/null \
      | xargs -I{} stat -f '%m {}' {} 2>/dev/null \
      | sort -nr \
      | head -1 \
      | cut -d' ' -f2-
  )"
fi
[[ -n "${OUT}" && -d "${OUT}" ]] || {
  echo "sync-adapters: could not find bible-core OUT_DIR" >&2
  exit 1
}

echo "sync-adapters: OUT_DIR=$OUT"
if [[ -f "$OUT/adapters.links.json" ]]; then
  cp "$OUT/adapters.links.json" "$ROOT/crates/core/data/adapters.links.json"
  echo "sync-adapters: updated data/adapters.links.json"
fi
if [[ -d "$OUT/adapter-icons" ]]; then
  mkdir -p "$ROOT/crates/core/data/adapter-icons"
  rm -f "$ROOT/crates/core/data/adapter-icons"/*.png
  cp "$OUT/adapter-icons"/*.png "$ROOT/crates/core/data/adapter-icons/" 2>/dev/null || true
  python3 - <<PY
import json, pathlib
root = pathlib.Path("$ROOT/crates/core/data/adapter-icons")
icons = sorted(
    {"id": p.stem, "file": p.name, "type": "png", "bytes": p.stat().st_size}
    for p in root.glob("*.png")
)
manifest = {
    "version": 1,
    "source": "scripts/sync-adapters (ROUTE_BIBLE_ADAPTERS=refresh → OUT_DIR)",
    "size": 64,
    "icons": icons,
}
pathlib.Path("$ROOT/crates/core/data/adapter-icons.json").write_text(
    json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
)
print(f"sync-adapters: {len(icons)} icons → data/adapter-icons/")
PY
fi

if rg -q 'refresh failed|returned HTML|404' /tmp/bible-core-adapters-build.log; then
  echo "sync-adapters: note — feed refresh did not succeed; committed snapshot was re-staged from data/" >&2
  echo "sync-adapters: when https://route.bible/adapters/v1 is published, re-run this script." >&2
fi
echo "sync-adapters: done"
